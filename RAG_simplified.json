    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body;\n\nconst messages = $input.first().json.body.messages || [];\nconst lastUserMessage = [...messages].reverse().find(m=>m.role == 'user')?.content || '';\n\nconst sessionId = body.sessionId || items[0].sessionId || items[0].json?.sessionId || \"default-session\";\n\nreturn [{json: { model: body.mode,\n               stream: body.stream || false,\n               userMessage: lastUserMessage,\n               rawMessages: messages,\n               sessionId : sessionId,\n               chatInput: lastUserMessage}}];\n\n"
      },
