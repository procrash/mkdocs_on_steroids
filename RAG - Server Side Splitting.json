    {
      "parameters": {
        "jsCode": "// Extract and prepare data from webhook payload\nconst body = $input.first().json.body;\n\nif (!body || !body.content) {\n  throw new Error('Invalid payload: content field required');\n}\n\nconst fileName = body.file_name || 'unknown';\nconst filePath = body.file_path || '';\nconst fileType = body.file_type || '';\nconst content = body.content;\nconst metadata = body.metadata || {};\n\n// Extract chunk config from metadata\nconst chunkSize = metadata.chunk_size || 1000;\nconst chunkOverlap = metadata.chunk_overlap || 200;\n\nreturn [{\n  json: {\n    content: content,\n    file_name: fileName,\n    file_path: filePath,\n    file_type: fileType,\n    chunk_size: chunkSize,\n    chunk_overlap: chunkOverlap,\n    metadata: {\n      ...metadata,\n      source: filePath\n    }\n  }\n}];"
      },
