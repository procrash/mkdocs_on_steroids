# Windows Environment Configuration for Document Upload Service
# Copy this to .env and adjust values as needed

# n8n RAG Service Endpoint - Python Script Upload (with proper embeddings)
N8N_WEBHOOK_URL=http://192.168.0.72:5678/webhook/upload_data_raw

# Old endpoint (BROKEN - skips embeddings, don't use)
# N8N_WEBHOOK_URL_OLD=http://192.168.0.72:5678/webhook/upload_data

# Splitting Configuration
DEFAULT_CHUNK_SIZE=1000
DEFAULT_CHUNK_OVERLAP=200

# Supported File Types
SUPPORTED_EXTENSIONS=.py,.cpp,.h,.hpp,.c,.cc,.cxx,.java,.js,.ts,.md,.txt,.pdf,.rst,.html,.xml,.json,.yaml,.yml

# Logging
LOG_LEVEL=INFO
