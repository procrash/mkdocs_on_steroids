    {
      "parameters": {
        "jsCode": "// Route to appropriate text splitter based on file type\nconst body = $input.first().json.body;\n\nif (!body || !body.content) {\n  throw new Error('Invalid payload: content field required');\n}\n\nconst fileName = body.file_name || 'unknown';\nconst filePath = body.file_path || '';\nconst fileType = body.file_type || '';\nconst content = body.content;\nconst metadata = body.metadata || {};\n\n// Extract chunk config from metadata\nconst chunkSize = metadata.chunk_size || 1000;\nconst chunkOverlap = metadata.chunk_overlap || 200;\n\n// Determine the splitter type based on file extension\nlet splitterType = 'default';\n\n// Markdown files\nif (['.md', '.markdown'].includes(fileType)) {\n  splitterType = 'markdown';\n}\n// Code files - use language-specific splitting\nelse if (['.cpp', '.cc', '.cxx', '.h', '.hpp', '.c'].includes(fileType)) {\n  splitterType = 'cpp';\n}\nelse if (['.py'].includes(fileType)) {\n  splitterType = 'python';\n}\nelse if (['.js', '.jsx'].includes(fileType)) {\n  splitterType = 'js';\n}\nelse if (['.ts', '.tsx'].includes(fileType)) {\n  splitterType = 'typescript';\n}\nelse if (['.java'].includes(fileType)) {\n  splitterType = 'java';\n}\nelse if (['.go'].includes(fileType)) {\n  splitterType = 'go';\n}\nelse if (['.rs'].includes(fileType)) {\n  splitterType = 'rust';\n}\nelse if (['.rb'].includes(fileType)) {\n  splitterType = 'ruby';\n}\nelse if (['.php'].includes(fileType)) {\n  splitterType = 'php';\n}\nelse if (['.html', '.htm'].includes(fileType)) {\n  splitterType = 'html';\n}\nelse if (['.sol'].includes(fileType)) {\n  splitterType = 'solidity';\n}\n\nreturn [{\n  json: {\n    content: content,\n    file_name: fileName,\n    file_path: filePath,\n    file_type: fileType,\n    splitter_type: splitterType,\n    chunk_size: chunkSize,\n    chunk_overlap: chunkOverlap,\n    metadata: metadata\n  }\n}];"
      },
