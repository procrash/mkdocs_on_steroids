# ============================================
# MkDocs with RAG & Docker Configuration
# ============================================
# Copy this file to .env and configure

# ============================================
# Source Code Path (for Docker mount)
# ============================================
SOURCE_CODE_PATH=./src

# ============================================
# LLM Configuration
# ============================================
LLM_PROVIDER=openai
# LLM_BASE_URL=http://host.docker.internal:1234/v1
# OPENAI_API_BASE=http://host.docker.internal:1234/v1
# ANTHROPIC_API_KEY=your-key-here
# OPENAI_API_KEY=your-key-here

# ============================================
# Proxy Configuration (Internal CORS Proxy)
# ============================================
# PROXY_TARGET_URL=https://api.openai.com/v1
# PROXY_PORT=8080

# ============================================
# GitHub Token for MCP Tools
# ============================================
# GITHUB_TOKEN=your-token-here
