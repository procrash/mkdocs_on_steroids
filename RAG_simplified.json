      "id": "c25079b7-b690-405b-abbd-27622dfd6595",
      "name": "Webhook - Python Upload",
      "webhookId": "new-python-upload-webhook-id"
    },
    {
      "parameters": {
        "jsCode": "// Extract chunks from Python uploader payload and prepare for Qdrant\nconst body = $input.first().json.body;\n\nif (!body || !body.chunks || !Array.isArray(body.chunks)) {\n  throw new Error('Invalid payload: chunks array required');\n}\n\nconst chunks = body.chunks;\nconst fileName = body.file_name || 'unknown';\nconst filePath = body.file_path || '';\nconst fileType = body.file_type || '';\nconst totalChunks = body.total_chunks || chunks.length;\nconst metadata = body.metadata || {};\n\n// Create output items in the format Qdrant expects\nconst outputItems = chunks.map((chunkText, index) => ({\n  json: {\n    // This is the text that will be embedded\n    text: chunkText,\n    // Metadata that will be stored with the vector\n    metadata: {\n      file_name: fileName,\n      file_path: filePath,\n      file_type: fileType,\n      chunk_index: index,\n      total_chunks: totalChunks,\n      source: filePath,\n      ...metadata\n    }\n  }\n}));\n\nreturn outputItems;"
      },
      "type": "n8n-nodes-base.code",
